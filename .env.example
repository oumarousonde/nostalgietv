# Copier ce fichier en .env et remplir les vraies valeurs.
# Cette liste est vérifiée contre le code (grep sur process.env.*) — rien de plus, rien de moins.

DATABASE_URL=postgresql://user:password@localhost:5432/nostalgietv

# Génère une valeur aléatoire longue, ex: openssl rand -hex 32
JWT_SECRET=

TMDB_API_KEY=
GEMINI_API_KEY=

# Nécessite une inscription validée au programme Amazon Associates (voir docs/04-aspects-legaux.md)
AMAZON_ASSOCIATE_TAG=

# Optionnel. Domaines autorisés à appeler l'API depuis un navigateur, séparés par
# des virgules (ex. https://nostalgietv.netlify.app). Vide = tout autorisé (pratique
# en développement uniquement — à restreindre explicitement avant la mise en prod).
CORS_ORIGIN=

# Nécessaire uniquement en local pour tester l'upload — sur Vercel, injectée
# automatiquement dès qu'un store Vercel Blob est lié au projet (rien à faire).
# Se récupère sur vercel.com → ton projet → Storage → Blob → onglet ".env.local"
BLOB_READ_WRITE_TOKEN=

# Protège /internal/cron/validate-referrals contre un déclenchement par n'importe
# qui. Génère une valeur aléatoire (ex: openssl rand -hex 32) et colle EXACTEMENT
# la même dans les variables d'environnement du projet Vercel — c'est ce qui
# permet à Vercel Cron Jobs (voir vercel.json) d'appeler cette route de façon
# authentifiée. Sans ça, la route refuse tout le monde, y compris Vercel lui-même.
# Ne rien mettre ici : VERCEL est définie automatiquement par la plateforme Vercel
# elle-même sur ses fonctions (voir src/app.ts, sert à ne pas lancer node-cron
# là où aucun process ne reste allumé). Listée ici juste pour référence.

CRON_SECRET=

PORT=3000

# URL publique du site une fois déployé — sert à générer le sitemap et robots.txt
PUBLIC_BASE_URL=https://nostalgietv.example.com

# Optionnel. Sans valeur, les SMS d'alerte sont juste logués dans la console au lieu
# d'être envoyés (voir src/services/notifications/sms.ts) — pas bloquant pour tester.
# Valeurs prévues : "orange" | "africas_talking" | "twilio" (aucune intégration réelle
# branchée encore derrière, quelle que soit la valeur — voir le fichier cité).
SMS_PROVIDER=
